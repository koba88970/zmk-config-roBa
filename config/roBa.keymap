#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/* require-prior-idle-ms が肝。
   「直前の打鍵から 150ms 経っていなければ、判定を待たずに必ずタップにする」
   これが無いと、A や Space のような高頻度キーで毎回 200ms の判定待ちが発生し、
   タイピングが追いつかなくなる。
   ・まだ取りこぼすなら 150 → 200 と上げる
   ・逆にレイヤーに入りにくいと感じたら 100 に下げる */

&mt {
    flavor = "balanced";
    tapping-term-ms = <200>;
    quick-tap-ms = <175>;
    require-prior-idle-ms = <150>;
};

&lt {
    flavor = "balanced";
    tapping-term-ms = <200>;
    quick-tap-ms = <175>;
    require-prior-idle-ms = <150>;
};

&trackball {
    //automouse-layer = <4>;

    scroll-layers = <4>;

    // arrows {
    //     layers = <3>;
    //     bindings =
    //         <&kp RIGHT_ARROW>,
    //         <&kp LEFT_ARROW>,
    //         <&kp UP_ARROW>,
    //         <&kp DOWN_ARROW>;
    //     tick = <10>;
    //     wait-ms = <5>;
    //     tap-ms = <5>;
    // };
};

/ {
    combos {
        compatible = "zmk,combos";

        tab {
            bindings = <&kp TAB>;
            key-positions = <11 12>;
        };

        minus {
            bindings = <&kp MINUS>;
            key-positions = <18 19>;
        };

        Cmd+A {
            bindings = <&kp LG(A)>;
            key-positions = <12 13>;
        };

        Cmd+Z {
            bindings = <&kp LG(Z)>;
            key-positions = <25 24>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;

            /* flavor 未指定だと ZMK 既定の hold-preferred になり、
               「他キーを押した瞬間にレイヤー確定」という最も誤爆しやすい動作になる。
               英数・かなは日本語入力で連打するので、明示的に balanced にする */

            flavor = "balanced";
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
        };

        /* エンコーダで本物のマウスホイールを送る。
           &kp 系のキーコード（C_AC_SCROLL_UP など）は macOS が解釈しないため、
           ポインティング用の &msc を呼び出す。
           ・回す向きが逆なら SCRL_UP と SCRL_DOWN を入れ替える
           ・1ノッチあたりのスクロール量が足りなければ tap-ms を増やす
           ※ KeymapEditor で保存するとこの定義が消えるので注意 */
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q             &kp W         &kp E             &kp R                        &kp T                                                        &kp Y        &kp U  &kp I      &kp O       &kp P
&kp A             &kp S         &kp D             &kp F                        &kp G        &kp C_PLAY_PAUSE                 &kp MINUS      &kp H        &kp J  &kp K      &kp L       &lt 3 SQT
&mt LEFT_SHIFT Z  &kp X         &kp C             &kp V                        &kp B        &kp LEFT_SHIFT                   &kp SEMICOLON  &kp N        &kp M  &kp COMMA  &kp PERIOD  &kp SLASH
&kp LCTRL         &kp LEFT_ALT  &kp LEFT_COMMAND  &lt_to_layer_0 2 LANGUAGE_2  &lt 3 SPACE  &lt_to_layer_0 4 LANGUAGE_1      &kp BACKSPACE  &lt 1 ENTER                                &kp ESCAPE
            >;

            sensor-bindings = <&inc_dec_kp LG(Z) LG(LS(Z))>;
        };

        FUNCTION {
            bindings = <
&kp F1  &kp F2  &kp F3  &kp F4  &kp F5                         &kp F6     &kp F7  &kp F8  &kp F9  &kp F10
&trans  &trans  &trans  &trans  &trans  &trans      &trans     &trans     &trans  &trans  &trans  &kp F11
&trans  &trans  &trans  &trans  &trans  &trans      &trans     &trans     &trans  &trans  &trans  &kp F12
&trans  &trans  &trans  &trans  &trans  &trans      &kp LG(C)  &kp LG(V)                          &trans
            >;
        };

        NUM {
            bindings = <
&kp GRAVE       &kp AMPERSAND    &kp ASTERISK  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS                              &kp N7        &kp N8        &kp N9        &kp N0     &trans
&kp LEFT_SHIFT  &kp DOLLAR       &kp PERCENT   &kp CARET             &kp LEFT_BRACKET       &trans      &trans          &kp NUMBER_4  &kp N5        &kp NUMBER_6  &kp MINUS  &kp EQUAL
&kp TAB         &kp EXCLAMATION  &kp AT_SIGN   &kp HASH              &kp RIGHT_BRACKET      &trans      &kp LEFT_SHIFT  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &trans     &trans
&trans          &trans           &trans        &trans                &trans                 &trans      &trans          &trans                                               &trans
            >;
        };

        MOUSE {
            bindings = <
&trans  &trans  &trans  &trans  &trans                         &trans     &kp LC(UP_ARROW)  &kp LS(LC(LG(NUMBER_4)))  &trans           &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans     &mo 4      &mkp MB1          &kp UP_ARROW              &mkp MB2         &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans     &trans     &kp LEFT_ARROW    &kp DOWN_ARROW            &kp RIGHT_ARROW  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &kp LG(C)  &kp LG(V)                                                               &trans
            >;
        };

        SCROLL {
            bindings = <
&trans  &trans  &trans  &trans  &trans                         &trans     &trans                    &trans     &trans                     &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans     &trans     &trans                    &kp LG(W)  &trans                     &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans     &trans     &kp LS(LG(LEFT_BRACKET))  &kp LG(T)  &kp LS(LG(RIGHT_BRACKET))  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &kp LG(C)  &kp LG(V)                                                                  &trans
            >;
        };

        layer_6 {
            bindings = <
&trans  &trans        &trans        &trans        &trans                           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans  &trans        &trans        &trans        &trans  &trans      &trans       &trans        &trans        &trans        &trans        &trans
&trans  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &trans  &trans      &bootloader  &trans        &trans        &trans        &trans        &bt BT_CLR
&trans  &trans        &trans        &trans        &trans  &trans      &trans       &trans                                                  &bt BT_CLR_ALL
            >;
        };
    };
};
